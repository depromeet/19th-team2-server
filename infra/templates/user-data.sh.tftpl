#!/bin/bash
set -Eeuo pipefail
umask 022

dnf install -y awscli-2 python3 tar gzip amazon-ssm-agent

# Install the official Linux ARM64 Temurin JDK and verify its release checksum.
temurin_dir=$(mktemp -d)
trap 'rm -rf "$temurin_dir"' EXIT
curl --fail --silent --show-error --location --retry 3 \
  'https://api.adoptium.net/v3/assets/latest/25/hotspot?architecture=aarch64&image_type=jdk&os=linux&vendor=eclipse' \
  --output "$temurin_dir/release.json"
temurin_url=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))[0]["binary"]["package"]["link"])' "$temurin_dir/release.json")
temurin_sha256=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))[0]["binary"]["package"]["checksum"])' "$temurin_dir/release.json")
curl --fail --silent --show-error --location --retry 3 "$temurin_url" --output "$temurin_dir/jdk.tar.gz"
printf '%s  %s\n' "$temurin_sha256" "$temurin_dir/jdk.tar.gz" | sha256sum --check --status
install -d -m 0755 /opt/temurin-25
tar -xzf "$temurin_dir/jdk.tar.gz" --strip-components=1 --no-same-owner -C /opt/temurin-25
ln -sfn /opt/temurin-25/bin/java /usr/bin/java
/usr/bin/java -version
rm -rf "$temurin_dir"
trap - EXIT

systemctl enable --now amazon-ssm-agent

id team2 >/dev/null 2>&1 || useradd --system --home-dir /var/lib/team2 --shell /sbin/nologin team2
install -d -m 0700 /etc/team2
install -d -m 0755 /opt/team2 /opt/team2/releases /usr/local/libexec
install -d -o team2 -g team2 -m 0750 /var/lib/team2

printf '%s' '${server_config}' | base64 --decode > /etc/team2/deploy.json
chmod 0600 /etc/team2/deploy.json
printf '%s' '${start_script}' | base64 --decode > /usr/local/libexec/team2-start
printf '%s' '${deploy_script}' | base64 --decode > /usr/local/sbin/team2-deploy
chmod 0750 /usr/local/libexec/team2-start /usr/local/sbin/team2-deploy
printf '%s' '${service_unit}' | base64 --decode > /etc/systemd/system/team2-server.service

curl --fail --silent --show-error --retry 3 \
  'https://truststore.pki.rds.amazonaws.com/${aws_region}/${aws_region}-bundle.pem' \
  --output /etc/pki/team2-rds-ca.pem
chmod 0644 /etc/pki/team2-rds-ca.pem

install -d /etc/systemd/journald.conf.d
cat > /etc/systemd/journald.conf.d/team2.conf <<'JOURNAL'
[Journal]
SystemMaxUse=100M
JOURNAL
systemctl restart systemd-journald

%{ if enable_https ~}
workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT
cd "$workdir"
curl --fail --silent --show-error --location --retry 3 \
  'https://github.com/caddyserver/caddy/releases/download/v${caddy_version}/caddy_${caddy_version}_linux_arm64.tar.gz' \
  --output caddy.tar.gz
curl --fail --silent --show-error --location --retry 3 \
  'https://github.com/caddyserver/caddy/releases/download/v${caddy_version}/caddy_${caddy_version}_checksums.txt' \
  --output checksums.txt
expected=$(awk '$2 == "caddy_${caddy_version}_linux_arm64.tar.gz" {print $1}' checksums.txt)
test -n "$expected"
printf '%s  caddy.tar.gz\n' "$expected" | sha256sum --check --status
tar -xzf caddy.tar.gz caddy
install -m 0755 caddy /usr/local/bin/caddy
id caddy >/dev/null 2>&1 || useradd --system --home-dir /var/lib/caddy --shell /sbin/nologin caddy
install -d -o caddy -g caddy -m 0750 /var/lib/caddy
install -d -m 0755 /etc/caddy
printf '%s' '${caddy_config}' | base64 --decode > /etc/caddy/Caddyfile
cat > /etc/systemd/system/caddy.service <<'CADDY'
[Unit]
Description=Caddy HTTPS reverse proxy
After=network-online.target
Wants=network-online.target

[Service]
User=caddy
Group=caddy
Environment=HOME=/var/lib/caddy
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caddy

[Install]
WantedBy=multi-user.target
CADDY
%{ endif ~}

systemctl daemon-reload
systemctl enable team2-server
%{ if enable_https ~}
systemctl enable --now caddy
%{ endif ~}
touch /var/lib/team2/bootstrap-complete
